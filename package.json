{
  "name": "quantcraft-app",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build:packages": "npm run build:quantlib && npm run build:finmath",
    "build:quantlib": "npm run build --workspace @quantcraft/quantlibjs",
    "build:finmath": "npm run build --workspace @quantcraft/finmath",
    "dev": "npm run build:packages && vite",
    "build": "npm run build:packages && tsc -b && vite build",
    "test": "npm run test:finmath && npm run test:quantlib && npm run test:games",
    "test:games": "npm run build:quantlib && npm run build:finmath && tsc -p test/tsconfig.json && node --test --test-concurrency=1 test/*.test.mjs",
    "test:finmath": "npm run test --workspace @quantcraft/finmath",
    "test:quantlib": "npm run test --workspace @quantcraft/quantlibjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@quantcraft/finmath": "workspace:*",
    "@quantcraft/quantlibjs": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
