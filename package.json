{
  "name": "quantcraft-app",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build:kernel && vite",
